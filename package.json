{
  "name": "va-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.15.0 <25",
    "bun": ">=1.4.3 <2"
  },
  "scripts": {
    "dev": "nx serve portfolio",
    "build": "nx build portfolio",
    "preview": "nx run portfolio:serve-static",
    "test": "nx run-many -t test",
    "test:watch": "nx test portfolio --watch",
    "lint": "nx run-many -t lint",
    "e2e": "nx e2e portfolio-e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "dev:api": "nx serve api",
    "dev:full": "nx run-many -t serve -p portfolio api --parallel=2",
    "typecheck": "nx run-many -t typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.3",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.3",
    "@angular-devkit/core": "22.2.3",
    "@angular-devkit/schematics": "22.2.3",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@playwright/test": "1.64.1",
    "@schematics/angular": "22.2.3",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "24.19.2",
    "@typescript-eslint/utils": "8.71.2",
    "angular-eslint": "22.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "1.8.3",
    "husky": "9.1.7",
    "jiti": "2.4.2",
    "jsdom": "22.1.0",
    "jsonc-eslint-parser": "2.4.2",
    "nx": "23.3.0",
    "prettier": "3.9.10",
    "ts-node": "10.9.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
